# =============================================================================
# CarSpares Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# cp .env.example .env
# OR run: node fix-env.js
# =============================================================================

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection URL
# Format: postgres://user:password@host:port/database
POSTGRES_URL=postgres://carspares:carspares@127.0.0.1:5433/carspares
DATABASE_URL=postgres://carspares:carspares@127.0.0.1:5433/carspares

# =============================================================================
# SERVICES
# =============================================================================
# Redis connection URL (for caching, sessions, job queues)
REDIS_URL=redis://localhost:6379

# OpenSearch URL (for product search)
OPENSEARCH_URL=http://localhost:9200

# Medusa Backend URL
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Storefront URL
STORE_CORS=http://localhost:3000

# Admin dashboard URL
ADMIN_CORS=http://localhost:7001

# Auth callback URL
AUTH_CORS=http://localhost:3000

# =============================================================================
# SECURITY SECRETS
# =============================================================================
# JWT Secret - CHANGE IN PRODUCTION!
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_change_in_production

# Cookie Secret - CHANGE IN PRODUCTION!
# Generate with: openssl rand -base64 32
COOKIE_SECRET=your_cookie_secret_here_change_in_production

# =============================================================================
# API KEYS
# =============================================================================
# Medusa Publishable API Key
# Get this from:
# 1. Medusa Admin UI: Settings > API Keys > Publishable Keys
# 2. Database: SELECT * FROM publishable_api_key;
# 3. After seeding: Check script output
NEXT_PUBLIC_PUBLISHABLE_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx
